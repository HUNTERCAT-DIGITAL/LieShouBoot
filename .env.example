# LieShouBoot · 环境变量（复制为 .env 后按需修改）
# 默认端口已避开开发机其他应用栈（LieShouCloud/LieShouCloudPro）

# —— 数据库 ——
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=43116

# —— 后端 ——
BACKEND_PORT=43115
JWT_SECRET=please-change-me-in-production-min-32-bytes-12345
JWT_ISSUER=lieshouboot-dev

# —— 前端 ——
FRONTEND_PORT=43117

# —— 开发机代理（容器下载依赖用；无代理环境留空自动直连） ——
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,postgres
